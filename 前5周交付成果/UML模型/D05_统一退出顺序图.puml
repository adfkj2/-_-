@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #456278
skinparam classBackgroundColor #F3F6FA
skinparam componentBackgroundColor #F3F6FA
skinparam packageBackgroundColor white
hide empty members
actor 浏览器 as B
participant "认证中心" as C
database MySQL as D
participant "业务应用 A 或 B" as A
B -> C : 进入中心退出确认页
C --> B : 当前会话范围与 CSRF 表单
B -> C : POST 统一退出
C -> D : 事务撤销当前 sid 及关联授权
D --> C : 提交成功
C -> C : 清除中心 HttpSession 与 Cookie
C --> B : 固定的已退出页面
B -> A : 再次请求受保护内容
A -> C : 后端内省现存令牌
C -> D : 发现 sid 已撤销
C --> A : active=false
A -> A : 清除本地应用会话
A --> B : 页面重新认证或 API 401
note over B,A
已经显示的历史页面无法收回
以退出事务提交后的新请求为验收边界
end note
@enduml
