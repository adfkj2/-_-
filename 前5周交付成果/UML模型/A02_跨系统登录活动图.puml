@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #35536C
skinparam classBackgroundColor #F3F6FA
skinparam usecaseBackgroundColor #F3F6FA
skinparam stateBackgroundColor #F3F6FA
skinparam sequenceParticipantBackgroundColor #F3F6FA
hide empty members
start
:用户访问业务应用;
if (应用会话有效?) then (是)
  :检查中心身份及应用权限;
else (否)
  :应用发起统一认证;
  if (中心会话有效?) then (是)
    :复用中心身份;
  else (否)
    :用户输入账号密码;
    if (凭据与账号状态有效?) then (是)
      :建立中心会话;
    else (否)
      :拒绝登录并记录失败;
      stop
    endif
  endif
  :检查目标应用权限;
endif
if (身份与应用权限均有效?) then (是)
  :确认应用身份并建立或复用应用会话;
  :返回受保护页面或数据;
else (否)
  :拒绝访问并给出原因;
endif
stop

@enduml
