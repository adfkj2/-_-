@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #35536C
skinparam classBackgroundColor #F3F6FA
skinparam usecaseBackgroundColor #F3F6FA
skinparam stateBackgroundColor #F3F6FA
skinparam sequenceParticipantBackgroundColor #F3F6FA
hide empty members
top to bottom direction
node "用户终端 浏览器" as U
node "认证服务 认证中心" as C
node "业务服务A 教务信息服务" as A
node "业务服务B 图书信息服务" as B
database 身份数据存储 as DB
U --> A : 业务访问
U --> B : 业务访问
U --> C : 登录与管理
A --> C : 认证与状态检查
B --> C : 认证与状态检查
C --> DB : 身份数据

@enduml
