@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam dpi 180
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #35536C
skinparam classBackgroundColor #F3F6FA
skinparam usecaseBackgroundColor #F3F6FA
skinparam stateBackgroundColor #F3F6FA
skinparam sequenceParticipantBackgroundColor #F3F6FA
hide empty members
left to right direction
actor 管理员 as M
rectangle 接入与审计 {
usecase "UC13 管理接入应用" as C13
usecase "UC14 配置应用授权" as C14
usecase "UC15 查询审计记录" as C15
usecase "UC16 查看登录及使用统计" as C16
usecase "UC17 配置安全策略" as C17
usecase "UC18 处理异常事件" as C18
}
M --> C13
M --> C14
M --> C15
M --> C16
M --> C17
M --> C18

@enduml
